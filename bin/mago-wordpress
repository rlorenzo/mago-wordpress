#!/usr/bin/env php
<?php

declare(strict_types=1);

use Rlorenzo\MagoWordPress\Internal\CommentConversion;
use Rlorenzo\MagoWordPress\Internal\FormatCommand;
use Rlorenzo\MagoWordPress\Internal\PhpcsMigration;

$autoloaders = [
    // Installed as a dependency: vendor/rlorenzo/mago-wordpress/bin.
    dirname(__DIR__, levels: 3) . '/autoload.php',
    // A clone of this package.
    dirname(__DIR__) . '/vendor/autoload.php',
];
foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

$args = array_slice($argv, 1);
$cwd = getcwd();
$cwd = $cwd === false ? '.' : $cwd;
$command = match ($args[0] ?? '') {
    'migrate' => static function () use ($args, $cwd): int {
        $result = PhpcsMigration::run(array_slice($args, 1), $cwd);
        if (is_int($result)) {
            return $result;
        }

        echo $result;

        return 0;
    },
    'convert-comments' => static fn(): int => CommentConversion::run(array_slice($args, 1), $cwd),
    'format' => static fn(): int => FormatCommand::run(array_slice($args, 1), $cwd),
    default => null,
};
if ($command === null) {
    fwrite(STDERR, <<<'USAGE'
        Usage: mago-wordpress migrate [<phpcs.xml or directory>] [--write] [--force]
               mago-wordpress format [<paths>...] [--check] [--staged]
               mago-wordpress convert-comments [<path>...] [--write]

        migrate: converts a phpcs ruleset into mago.toml and composer.json extra.mago-wordpress.
        Prints the result by default; --write saves both next to the ruleset (--force
        overwrites an existing mago.toml). Lists everything that could not be migrated.

        format: formats PHP files for WordPress (`mago-wordpress format --help` for details).

        convert-comments: converts phpcs:ignore/disable comments, and @mago-expect pragmas naming superseded
        core rules, into @mago-expect pragmas counted from a lint run. Prints a per-comment
        report by default; --write applies it and re-lints to check the result.

        USAGE);
    exit(($args[0] ?? '') === '--help' ? 0 : 2);
}

exit($command());
